From 5b00663f685573a3c025b03e604eba6338a0d92e Mon Sep 17 00:00:00 2001
From: Le-Syl21 <sylvain.gargasson@gmail.com>
Date: Sat, 7 Nov 2026 23:12:26 +0000
Subject: [PATCH 09/11] Playmatic Zira (PLAYZ): log the sound command, not
 nothing

The Zira board has no data write: the game drives its three command
lines (bits 4-6 of the lamp port) through sndbrd_ctrl_w, which does not
call snd_cmd_log, so AltSound received no command at all.

The sound CPU reads those lines as a level (inverted, 0 = idle), so a
command is a new non-idle value of the three lines. Log it once, when the
level changes to a non-idle value, as the byte the line carries (10, 20
.. 70), which is what the AltSound packs are keyed on. The board still
gets every write, so the audio is unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ENsGGxgZ7pU5Z87YfBS2iY
---
 src/wpc/play.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/wpc/play.c b/src/wpc/play.c
index 00c9bbd7..ab7febd1 100644
--- a/src/wpc/play.c
+++ b/src/wpc/play.c
@@ -80,6 +80,7 @@ static struct {
   int    panelSel;
   int    cpuType;
   int    resetDone;
+  int    sndLines;    // Zira board command lines (bits 4-6 of the lamp port) as last written
   int    sndLevel;    // sound board command lines (3 bits) as last written, see play3_sndCmd
   int    sndCmdFirst; // first value of the command in progress, or -1 if none
 
@@ -302,6 +303,13 @@ static WRITE_HANDLER(out2_n) {
         }
       }
       if (core_gameData->hw.soundBoard == SNDBRD_PLAYZ) {
+        /* The Zira board has no data write: its COP420 reads bits 4-6 of this port as a level
+           (inverted, 0 = idle). Log the command each time the level changes to a non-idle value;
+           this is the byte (10, 20 .. 70) the AltSound packs are keyed on. The board still gets
+           every write, so the audio is unchanged. */
+        if ((data & 0x70) != locals.sndLines && (data & 0x70))
+          snd_cmd_log(0, data & 0x70);
+        locals.sndLines = data & 0x70;
         sndbrd_0_ctrl_w(0, data & 0x70);
       } else if (core_gameData->hw.soundBoard == SNDBRD_PLAY3) {
         if (locals.cpuType < 2) {
